# Camera Configuration (Wyze Cam with Dafang-Hacks, RTSP, or IP camera snapshot)
WYZE_CAM_URL= http://192.168.1.50/cgi-bin/currentpic.cgi
WYZE_CAM_USER=admin
WYZE_CAM_PASS=your_camera_password

# Motion & Cooldown Sensitivity
MOTION_THRESHOLD=3.0
ALERT_COOLDOWN_SEC=30

# Discord Bot Notifications
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id

# Local Edge Model (Ollama)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
VISION_MODEL=gemma4:e2b-it-q4_K_M
